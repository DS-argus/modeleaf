.DS_Store
.build/
DerivedData/
*.xcresult
xcuserdata/
.swiftpm/
__pycache__/
*.pyc
*.xcuserstate

# OMX workflow plans, state, and runtime files remain local-only.
.omx/
.gjc/

# Runtime/user configuration is never stored in the repository.
config.toml

# Local-only product and verification notes are not published.
.internal/
.worktrees/

# Local agent operating instructions are workstation-only.
CLAUDE.md
AGENTS.md

# Local build/verification evidence (logs, snapshots, xcresults) is not published.
artifacts/
docs/windows-porting/
docs/*.png
docs/DESIGN.md
docs/handoffs

# Stray/user PDFs are never part of the repo.
*.pdf
